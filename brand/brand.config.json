{
  "_comment": "Permanent brand specification. Do not change colors, typography, character or subtitle settings without owner approval.",
  "version": "1.0.0-draft",
  "brand": {
    "name": "{{BRAND_NAME}}",
    "workingName": "The Curious Circuit (NOT APPROVED - placeholder only)",
    "tagline": "Big questions. Simple explanations.",
    "nameApproved": false
  },
  "colors": {
    "bg": "#0F1116",
    "bg2": "#141820",
    "ivory": "#F5F3EE",
    "orange": "#FF7A3D",
    "slate": "#9AA7B8",
    "blue": "#3B82F6",
    "_derived_comment": "Shades derived from the palette for character shading and depth only; not used as independent theme colors.",
    "derived": {
      "ivoryShade": "#D9D5CC",
      "ivoryDeep": "#B9B4AA",
      "joint": "#2A2E36",
      "jointDeep": "#1C1F26",
      "display": "#07080B",
      "displayRim": "#1E222B"
    }
  },
  "typography": {
    "family": "Inter",
    "weight": 400,
    "boldAllowed": false,
    "fallback": "Inter, 'Helvetica Neue', Arial, sans-serif"
  },
  "video": {
    "vertical": { "width": 1080, "height": 1920, "fps": 30 },
    "longform": { "width": 1920, "height": 1080, "fps": 30, "status": "future" },
    "codec": { "video": "libx264", "profile": "high", "pixFmt": "yuv420p", "crf": 16, "preset": "slow", "audio": "aac", "audioBitrate": "192k", "sampleRate": 48000 },
    "loudness": { "integratedLUFS": -14, "truePeakDBTP": -1 }
  },
  "safeArea": {
    "_comment": "Pixel boxes on the 1080x1920 canvas. 'core' stays visible in 1:1 and 4:5 center crops and clear of platform UI.",
    "core": { "x": 140, "y": 420, "w": 800, "h": 1000 },
    "crop1x1": { "x": 0, "y": 420, "w": 1080, "h": 1080 },
    "crop4x5": { "x": 0, "y": 285, "w": 1080, "h": 1350 },
    "platformUI": {
      "top": 220,
      "bottom": 420,
      "right": 160,
      "left": 60,
      "_note": "Approximate union of YouTube Shorts and Facebook Reels overlays; re-check against current apps before each season."
    }
  },
  "subtitles": {
    "font": "Inter",
    "weight": 400,
    "sizePx": 44,
    "lineHeight": 1.3,
    "color": "#F5F3EE",
    "emphasisColor": "#FF7A3D",
    "maxLines": 2,
    "maxCharsPerLine": 32,
    "align": "center",
    "centerY": 1330,
    "maxWidthPx": 820,
    "shadow": "0 2px 8px rgba(0,0,0,0.55)",
    "minDurationSec": 0.8,
    "maxDurationSec": 4.0,
    "animation": "fade 0.12s",
    "forbidden": ["bold", "karaoke", "bounce", "large background boxes", "thick outlines"]
  },
  "motion": {
    "shotLengthSec": [1.5, 3.0],
    "transitionSec": [0.15, 0.4],
    "defaultEase": "power2.inOut",
    "forbidden": ["glitch", "random shake", "flashing", "bouncing type", "overdone zoom"]
  },
  "character": {
    "id": "host-robot",
    "rig": "character/rig/robot.js",
    "reference": "character/reference/storyboard-reference.webp",
    "approved": false
  },
  "narration": {
    "provider": "elevenlabs",
    "voiceId": null,
    "model": null,
    "settings": null,
    "_note": "Lock voice ID and settings after owner approves a voice."
  }
}
